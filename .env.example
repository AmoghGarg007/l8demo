# Copy to .env.local and fill in real values.

# --- Recruitment and admin ---
TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

JWT_SECRET="generate-with-openssl-rand-base64-32"
ADMIN_SRNS="PES2UG25CS001,PES2UG25CS002"

# Optional Google Sheets sync
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-sa@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="your-google-sheet-id"

# --- Weekly CTF ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Add after CAPTCHA is enabled in Supabase Authentication settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Used only by scripts/provision-ctf-user.mjs. Never commit a real password.
CTF_INITIAL_PASSWORD=