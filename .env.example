# Copy to .env.local and fill in real values. Nothing here is a secret.

# --- /recruitments + /admin ---
# Turso (libsql) database. Create a free DB at https://turso.tech, then
# `turso db show <name> --url` / `turso db tokens create <name>`.
TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Session signing key — generate with `openssl rand -base64 32`. Use a
# different value per environment; never reuse the same one across them.
JWT_SECRET="generate-with-openssl-rand-base64-32"

# Comma-separated SRNs granted the "admin" role on their next login.
ADMIN_SRNS="PES2UG25CS001,PES2UG25CS002"

# Google Sheets sync (optional — /api/apply degrades gracefully and just
# logs a warning if these are unset; applications still save to Turso).
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-sa@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="your-google-sheet-id"
